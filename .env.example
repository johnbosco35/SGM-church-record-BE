# ---- Core ----
NODE_ENV=development
PORT=4000
# Local: mongodb://127.0.0.1:27017/church_db   Atlas: mongodb+srv://USER:PASS@cluster/church_db
MONGODB_URI=mongodb://127.0.0.1:27017/church_db

# ---- Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ----
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-xxxxxxxx
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
BCRYPT_ROUNDS=12
# Public self-registration creates a no-privilege "member" account only. Keep false unless you need it.
ALLOW_PUBLIC_REGISTRATION=false

# ---- Cookies / CORS ----
# Comma-separated list of exact frontend origins. Never use * with credentials.
CORS_ORIGINS=http://localhost:5173
# Leave COOKIE_SECURE unset to default to true in production, false otherwise.
# COOKIE_SECURE=true
# lax = frontend and API on the same site (recommended). none = different sites (requires Secure + HTTPS).
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.yourparish.org
# Set to the number of reverse proxies in front of the app (e.g. 1 on Render/Heroku/Nginx).
TRUST_PROXY=0

# ---- Uploads (private storage, never served statically) ----
UPLOAD_DIR=./uploads
UPLOAD_MAX_FILE_MB=10
UPLOAD_MAX_FILES=10

# ---- Providers ----
# mock = development only; returns EMPTY drafts flagged for human entry. It performs NO real OCR.
EXTRACTION_PROVIDER=mock
# mock = keyword answers from published content, clearly labelled. anthropic = real model (needs key).
CHAT_PROVIDER=mock
# ANTHROPIC_API_KEY=
# CHAT_MODEL=claude-sonnet-5-5

# ---- Hardening ----
BODY_LIMIT_KB=100
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_PUBLIC_FORM_MAX=10
RATE_LIMIT_CHAT_MAX=30
RATE_LIMIT_UPLOAD_MAX=30
RATE_LIMIT_GENERAL_MAX=300
# Swagger UI at /api/docs. Defaults to on outside production.
# ENABLE_DOCS=true

# ---- Seeding the first admin (npm run seed:admin) ----
# SEED_ADMIN_EMAIL=admin@example.org
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=Parish Administrator
